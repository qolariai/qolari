build-type:     Simple

source-repository head
  type: git
  location: https://github.com/qolariai/qolari

flag Local
  description: Enable this flag for faster compile times
  manual: True
  default: False

library
  exposed-modules:
      Dashboard
      FileManagementUnitTests
  other-modules:
      RegistrationUnitTests
      VehicleAssociationUnitTests
      DriverDocumentUploadUnitTests
      AddVehicleUnitTests
      DriverOperationHubUnitTests
      CreateRequestUnitTests
      EmailOtpUnitTests
      MerchantDocumentUnitTests
      MediaFileUploadStatusUnitTests
      RewardsEvaluatorTests
      RewardsCouponTemplatedTests
      RewardsCouponPoolTests
  hs-source-dirs:
      src
  default-extensions:
      ConstraintKinds
      DataKinds
      DefaultSignatures
      DeriveAnyClass
      DeriveFunctor
      DeriveGeneric
      DuplicateRecordFields
      FlexibleContexts
      FlexibleInstances
      FunctionalDependencies
      GADTs
      LambdaCase
      MultiParamTypeClasses
      MultiWayIf
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedStrings
      PackageImports
      PatternSynonyms
      PolyKinds
      RankNTypes
      RecordWildCards
      ScopedTypeVariables
      TupleSections
      TypeApplications
      TypeFamilies
      TypeOperators
      ViewPatterns
  build-depends:
      HUnit
    , aeson
    , base >=4.7 && <5
    , beckn-services
    , beckn-spec
    , bytestring
    , containers
    , dashboard-helper-api
    , data-default-class
    , directory
    , dynamic-offer-driver-app
    , euler-hs
    , hspec
    , hspec-core
    , http-conduit
    , http-types
    , lens
    , lib-dashboard
    , mobility-core
    , mock-sms
    , mtl
    , provider-dashboard
    , record-dot-preprocessor
    , record-hasfield
    , rider-app
    , shared-services
    , string-conversions
    , tasty
    , tasty-hspec
    , tasty-hunit
    , text
    , time
    , transformers
    , unix
    , unordered-containers
    , uuid
    , vector
    , yudhishthira
  default-language: Haskell2010

executable hunit-tests
  main-is: Main.hs
  other-modules:
      Paths_hunit_tests
  hs-source-dirs:
      app
  default-extensions:
      ConstraintKinds
      DataKinds
      DefaultSignatures
      DeriveAnyClass
      DeriveFunctor
      DeriveGeneric
      DuplicateRecordFields
      FlexibleContexts
      FlexibleInstances
      FunctionalDependencies
      GADTs
      LambdaCase
      MultiParamTypeClasses
      MultiWayIf
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedStrings
      PackageImports
      PatternSynonyms
      PolyKinds
      RankNTypes
      RecordWildCards
      ScopedTypeVariables
      TupleSections
      TypeApplications
      TypeFamilies
      TypeOperators
      ViewPatterns
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -T"
  build-depends:
      HUnit
    , aeson
    , base >=4.7 && <5
    , beckn-services
    , beckn-spec
    , bytestring
    , containers
    , dashboard-helper-api
    , data-default-class
    , directory
    , dynamic-offer-driver-app
    , euler-hs
    , hspec
    , hspec-core
    , http-conduit
    , http-types
    , hunit-tests
    , lens
    , lib-dashboard
    , mobility-core
    , mock-sms
    , mtl
    , provider-dashboard
    , record-dot-preprocessor
    , record-hasfield
    , rider-app
    , shared-services
    , string-conversions
    , tasty
    , tasty-hspec
    , tasty-hunit
    , text
    , time
    , transformers
    , unix
    , unordered-containers
    , uuid
    , vector
    , yudhishthira
  default-language: Haskell2010
  if flag(Local)
    ghc-options: -Wno-ambiguous-fields -Wno-incomplete-uni-patterns -Wno-incomplete-record-updates -O0 -funfolding-use-threshold20 -fno-cse -fmax-simplifier-iterations1 -fno-specialise-aggressively -j4
  else
    ghc-options: -O2 -j4
