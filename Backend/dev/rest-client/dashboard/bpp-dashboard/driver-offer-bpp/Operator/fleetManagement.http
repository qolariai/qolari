# access tokens with different roles
@customer = {{bpp-dashboard/token/qolari_PARTNER/customer}}
@driver = {{bpp-dashboard/token/qolari_PARTNER/driver}}
@Qolari_ops = {{bpp-dashboard/token/qolari_PARTNER/Qolari_ops}}
@Qolari_admin = {{bpp-dashboard/token/qolari_PARTNER/Qolari_admin}}
@customer_service = {{bpp-dashboard/token/qolari_PARTNER/customer_service}}

@operator = favorit-operator-token0-000000000000

# @name healthcheck
GET {{bpp-dashboard-host}}

###

# @name postFleetManagementFleetLinkSendOtp

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/operator/fleet/link/sendOtp
token: {{operator}}
content-type: application/json

{   "mobileNumber": "3223345684",
    "mobileCountryCode": "+91"
}

###

# @name postFleetManagementFleetLinkVerifyOtp

@personId = {{postFleetManagementFleetLinkSendOtp.response.body.fleetOwnerId}}

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/operator/fleet/link/verifyOtp
token: {{operator}}
content-type: application/json

{   "fleetOwnerId": "{{personId}}",
    "otp": "7891"
}
