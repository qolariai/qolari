# access tokens with different roles
@customer = {{bpp-dashboard/token/qolari_PARTNER/customer}}
@driver = {{bpp-dashboard/token/qolari_PARTNER/driver}}
@Qolari_ops = {{bpp-dashboard/token/qolari_PARTNER/Qolari_ops}}
@Qolari_admin = {{bpp-dashboard/token/qolari_PARTNER/Qolari_admin}}
@customer_service = {{bpp-dashboard/token/qolari_PARTNER/customer_service}}

@image-api-helper-host = http://localhost:8099
@fileFolder = ./dev/rest-client/dashboard/bpp-dashboard/driver-offer-bpp/image
@fileOriginal = leo.jpg
@fileCopy = leo2.jpg


###
# @name healthcheck

GET {{image-api-helper-host}}

###
# @name encodeFile

GET {{image-api-helper-host}}/encode
Content-Type: application/json

{
    "filePath": "{{fileFolder}}/{{fileOriginal}}"
}

###
@encodedFile = {{encodeFile.response.body.base64}}
#@driverId = favorit-hatchback-000000000000000000
@driverId = favorit-sedan-0000000000000000000000

###

# @name uploadDoc
@docType = DriverLicense
# @docType = VehicleRegistrationCertificate

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/driver/{{driverId}}/document/upload
token: {{Qolari_ops}}
content-type: application/json

{
    "imageBase64": "{{encodedFile}}",
    "imageType": "{{docType}}"
}

###

# @name fetchImage
GET {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/driver/getDocument/{{imageId}}
token: {{Qolari_admin}}

###
@fetchedEncodedFile = {{fetchImage.response.body.imageBase64}}
###
# @name decodeFile

POST {{image-api-helper-host}}/decode
Content-Type: application/json

{
    "filePath": "{{fileFolder}}/{{fileCopy}}",
    "base64": "{{fetchedEncodedFile}}"
}

###

# @name registerDL

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/driver/{{driverId}}/register/dl
token: {{Qolari_admin}}
Content-Type: application/json

{
    "driverLicenseNumber": "12345",
    "driverDateOfBirth": "2000-10-25T14:01:41.092848055Z",
    "imageId1": "{{imageId}}",
    "operatingCity": "Bangalore"
}

###

# @name registerRC

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/driver/{{driverId}}/register/rc
token: {{Qolari_admin}}
Content-Type: application/json

{
    "vehicleRegistrationCertNumber": "KAE4R2,231",
    "imageId": "{{imageId}}",
    "operatingCity": "Bangalore"
}
