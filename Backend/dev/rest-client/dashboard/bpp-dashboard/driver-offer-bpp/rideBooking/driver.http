# access tokens with different roles
@customer = {{bpp-dashboard/token/qolari_PARTNER/customer}}
@driver = {{bpp-dashboard/token/qolari_PARTNER/driver}}
@Qolari_ops = {{bpp-dashboard/token/qolari_PARTNER/Qolari_ops}}
@Qolari_admin = {{bpp-dashboard/token/qolari_PARTNER/Qolari_admin}}
@customer_service = {{bpp-dashboard/token/qolari_PARTNER/customer_service}}

# @name healthcheck
GET {{bpp-dashboard-host}}

###

# @name enableDriver

@driverId1 = favorit-auto1-0000000000000000000000

# @name healthcheck
GET {{bpp-dashboard-host}}

###

# @name driverEnable
POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/driver/{{driverId1}}/enable
token: {{Qolari_ops}}
content-type: application/json

###

# @name driverInfo
GET {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/driver/info
?personId=favorit-suv-000000000000000000000000
token: {{Qolari_ops}}
