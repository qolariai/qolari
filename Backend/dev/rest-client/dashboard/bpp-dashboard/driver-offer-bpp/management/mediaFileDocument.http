# access tokens with different roles
@customer = {{bpp-dashboard/token/qolari_PARTNER/customer}}
@driver = {{bpp-dashboard/token/qolari_PARTNER/driver}}
@Qolari_ops = {{bpp-dashboard/token/qolari_PARTNER/Qolari_ops}}
@Qolari_admin = {{bpp-dashboard/token/qolari_PARTNER/Qolari_admin}}
@customer_service = {{bpp-dashboard/token/qolari_PARTNER/customer_service}}
@operator = favorit-operator-token0-000000000000

###

# @name postMediaFileDocumentUploadLink

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/mediaFileDocument/uploadLink
token: {{operator}}
content-type: application/json

{ "mediaFileDocumentType": "VehicleVideo",
  "fileType": "Video",
  "reqContentType": "video/mp4",
  "rcNumber": "WB1234567"
}

###

# @name getMediaFileDocumentDownloadLink

GET {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/mediaFileDocument/downloadLink
  ?mediaFileDocumentType="VehicleVideo"
  &rcNumber=WB1234567
token: {{operator}}
content-type: application/json

###

# @name postMediaFileDocumentConfirm

@mediaFileDocumentId = {{getMediaFileDocumentDownloadLink.response.body.mediaFileDocumentId}}

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/mediaFileDocument/confirm
token: {{operator}}
content-type: application/json

{ "mediaFileDocumentId": "{{mediaFileDocumentId}}"
}

###

# @name postMediaFileDocumentDelete

POST {{bpp-dashboard-host}}/bpp/driver-offer/qolari_PARTNER/KOCHI/mediaFileDocument/delete
token: {{operator}}
content-type: application/json

{ "mediaFileDocumentId": "{{mediaFileDocumentId}}"
}
