# @name CustomerBookingStatusAPI

@rideBookingId = 00000000-0000-0000-0000-000000000000
@customerId = 00000000-0000-0000-0000-000000000001

POST {{bap-dashboard-host}}/bap/YATRI/rideBooking/booking/ridebooking/{{rideBookingId}}/{{customerId}}
content-type: application/json
token: {{Qolari_admin}}
